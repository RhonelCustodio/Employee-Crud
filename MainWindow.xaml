<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="EmployeeCrud.MainWindow"
        Title="People — Employee Manager" Width="1180" Height="800"
        MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14" Foreground="#172B43">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="PEOPLE / WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#25766C"/>
                <TextBlock Text="Employee directory" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,5"/>
                <TextBlock Text="Keep your team’s details in one place." Foreground="#64748B"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="_Log out" Click="Logout_Click" Padding="14,8"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="_Refresh" Click="Refresh_Click"/>
                        <StackPanel>
                            <TextBlock Text="Your team" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CountText" Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="SearchBox" Margin="0,0,0,16"
                             ToolTip="Search by name, email, or department"
                             AutomationProperties.Name="Search employees"
                             TextChanged="SearchBox_TextChanged"/>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF1F5" BorderThickness="0"
                                  Background="White" RowHeaderWidth="0" AlternatingRowBackground="#FAFCFE"
                                  SelectionChanged="EmployeesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="1.1*" MinWidth="130"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*" MinWidth="160"/>
                                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*" MinWidth="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Text="No employees yet. Add your first team member →"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#64748B" IsHitTestVisible="False" TextWrapping="Wrap" MaxWidth="340"/>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="Search above · Select a row to edit · Click a heading to sort"
                               FontSize="11" Foreground="#64748B" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0"
                    BorderThickness="1" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="New Employee" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EditorSubtitle" Text="All fields are required." Foreground="#64748B" Margin="0,6,0,6"/>
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="Full name"/>
                        <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EmailBox" MaxLength="254" AutomationProperties.Name="Email address"/>
                        <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DepartmentBox" MaxLength="100" AutomationProperties.Name="Department"/>
                        <TextBlock x:Name="ValidationText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="SaveButton" Content="_Add employee" Click="Save_Click"
                                Background="#167568" Foreground="White" Margin="0,18,0,10"/>
                        <Button x:Name="DeleteButton" Content="_Delete employee" Click="Delete_Click"
                                Background="#FEF0EF" Foreground="#B42318" IsEnabled="False"/>
                        <TextBlock Text="A successful save clears this form. Select a row to edit that employee. Refresh also clears the form."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,22,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready" Foreground="#526174"
                   FontSize="12" Margin="2,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
